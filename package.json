{
  "name": "ikimetr-realtor-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "backup": "pnpm --filter @ikimetr/worker exec tsx ../../scripts/backup.mjs",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @ikimetr/database db:migrate",
    "db:seed": "pnpm --filter @ikimetr/database db:seed",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "start:local": "node scripts/start-local.mjs",
    "start:production": "node scripts/start-local.mjs",
    "status": "pnpm --filter @ikimetr/worker exec tsx ../../scripts/status.mjs",
    "test": "vitest run",
    "test:smoke": "pnpm --filter @ikimetr/web test:smoke",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.10"
  }
}
